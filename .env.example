# Copy this file to ".env" and fill in your keys. The .env file is gitignored.

# ── Anthropic ─────────────────────────────────────────────────────────────────
# Required for the Proofread button and the Claude chat panel:
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Optional — model overrides:
# ANTHROPIC_MODEL=claude-sonnet-4-6       # proofread
# ANTHROPIC_CHAT_MODEL=claude-opus-4-8    # chat panel

# ── Supabase ──────────────────────────────────────────────────────────────────
# Resumes are stored in the `resume_builder` schema of the "Chaos Database" project.
#
# The service_role key bypasses RLS and must NEVER reach the browser. It stays here,
# server-side only. Grab it from:
#   Supabase Dashboard > Project Settings > API > service_role (secret)
#
# One-time setup: add `resume_builder` to
#   Dashboard > Project Settings > API > Exposed schemas
# otherwise PostgREST will refuse to serve the tables.
SUPABASE_URL=https://hdzflottfwtqfkvmwsnw.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
